{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShareX Lite",
  "version": "0.1.0",
  "identifier": "app.sharex.lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShareX Lite",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis"],
    "category": "Utility",
    "shortDescription": "Lightweight cross-platform capture and upload utility.",
    "longDescription": "A compact Rust and Tauri rewrite of the core ShareX capture, copy, save, upload, history, tray, and shortcut workflows."
  }
}
