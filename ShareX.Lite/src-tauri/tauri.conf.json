{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShareX Lite",
  "version": "0.1.0",
  "identifier": "app.sharex.lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShareX Lite",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "轻量级跨平台截图与上传工具。",
    "longDescription": "基于 Rust 和 Tauri 的精简版 ShareX，覆盖截图、复制、保存、上传、历史记录、托盘和快捷键等核心流程。"
  }
}
